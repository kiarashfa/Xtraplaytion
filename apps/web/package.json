    "@tailwindcss/vite": "4.3.3",
    "@xtraplaytion/dmath": "workspace:*",
    "@xtraplaytion/engine": "workspace:*",
    "@xtraplaytion/expr": "workspace:*",
    "astro": "7.4.4",
    "katex": "0.19.1",
    "svelte": "5.57.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "playwright-core": "1.64.1",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5"
