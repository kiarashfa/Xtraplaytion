---
import ExtrapolationFigure from '../components/ExtrapolationFigure.astro';
import { localeInfo, useTranslations } from '../i18n';
import { LESSONS } from '../lib/lessons.ts';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url.ts';

const t = useTranslations();
const continueTemplate = localeInfo().catalog['learn.continueShort'];
const order = LESSONS.map((l) => ({ slug: l.slug, n: l.n }));
const features = [
  t('home.feature.target'),
  t('home.feature.ood'),
  t('home.feature.race'),
  t('home.feature.save'),
  t('home.feature.export'),
];
---

<Base>
  <section class="pt-6 pb-10 sm:pt-12">
    <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-sm text-muted">
      <span class="size-2 rounded-full bg-target" aria-hidden="true"></span>
      <span>
        <strong class="font-semibold text-ink">{t('home.status')}.</strong> {t('home.statusDetail')}
      </span>
    </p>
    <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-balance sm:text-5xl">
      {t('home.title')}
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-muted">{t('home.lead')}</p>
    <div class="mt-7 flex flex-wrap gap-3">
      <a href={url('playground/')} class="xp-btn xp-btn-primary min-h-12 px-5 text-base">
        {t('home.cta')}
      </a>
      <a
        href={url('lessons/activations-and-extrapolation/')}
        class="xp-btn min-h-12 px-5 text-base"
        data-continue-lesson={continueTemplate}
        data-order={JSON.stringify(order)}
      >
        {t('home.ctaLesson')}
      </a>
      <a href={url('gallery/')} class="xp-btn min-h-12 px-5 text-base">
        {t('home.ctaGallery')}
      </a>
    </div>
  </section>

  <ExtrapolationFigure />

  <section class="mt-12 grid gap-8 sm:grid-cols-[1fr_1fr]">
    <div>
      <h2 class="text-xl font-semibold tracking-tight">{t('home.featuresTitle')}</h2>
      <ul class="mt-4 space-y-3">
        {features.map((item) => (
          <li class="flex gap-3">
            <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="self-start rounded-2xl border border-line bg-surface p-5 text-muted">
      <p>{t('home.privacy')}</p>
    </div>
  </section>
</Base>

<script>
  // With lessons learned in this browser, the lesson button continues where the visitor left off.
  import { createFormatter } from '../i18n/format.ts';
  import { isLearned, learningMirror } from '../lib/account/learning.ts';
  import { url } from '../lib/url.ts';

  const link = document.querySelector<HTMLAnchorElement>('[data-continue-lesson]');
  if (link) {
    const order = JSON.parse(link.dataset['order'] ?? '[]') as { slug: string; n: number }[];
    const l = learningMirror();
    const next = order.find((x) => !isLearned(l, x.slug));
    if (next && order.some((x) => isLearned(l, x.slug))) {
      link.href = url(`lessons/${next.slug}/`);
      link.textContent = createFormatter(document.documentElement.lang || 'en').format(
        link.dataset['continueLesson'] ?? '',
        { n: next.n },
      );
    }
  }
</script>
