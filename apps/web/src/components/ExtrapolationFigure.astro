---
/**
 * Static hero illustration, computed at build time: noisy samples of a wave
 * inside a training range, a model that fits them, then extrapolates linearly
 * (the way a ReLU network does) outside the range.
 */
import { useTranslations } from '../i18n';

const t = useTranslations();

const W = 720;
const H = 320;
const pad = { l: 16, r: 16, t: 44, b: 20 };
const xMin = -7.5;
const xMax = 7.5;
const yMin = -1.9;
const yMax = 1.9;
const band: [number, number] = [-3.2, 3.2];

const sx = (x: number) => pad.l + ((x - xMin) / (xMax - xMin)) * (W - pad.l - pad.r);
const sy = (y: number) => pad.t + ((yMax - y) / (yMax - yMin)) * (H - pad.t - pad.b);

const f = (x: number) => Math.sin(1.1 * x) + 0.12 * x;
const df = (x: number) => 1.1 * Math.cos(1.1 * x) + 0.12;

// Model: close to f inside the band, straight lines outside (slightly damped slope).
const model = (x: number) => {
  if (x < band[0]) return f(band[0]) + 0.4 * df(band[0]) * (x - band[0]);
  if (x > band[1]) return f(band[1]) + 0.4 * df(band[1]) * (x - band[1]);
  return f(x) + 0.04 * Math.sin(3.3 * x);
};

const path = (fn: (x: number) => number, a: number, b: number, n = 240) => {
  let d = '';
  for (let i = 0; i <= n; i++) {
    const x = a + ((b - a) * i) / n;
    d += `${i ? 'L' : 'M'}${sx(x).toFixed(1)} ${sy(fn(x)).toFixed(1)}`;
  }
  return d;
};

// Seeded noise so every build is identical.
let seed = 7;
const rand = () => (seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0) / 4294967296;
const gauss = () => Math.sqrt(-2 * Math.log(1 - rand())) * Math.cos(2 * Math.PI * rand());
const points = Array.from({ length: 34 }, (_, i) => {
  const x = band[0] + ((band[1] - band[0]) * (i + 0.5)) / 34;
  return { cx: sx(x).toFixed(1), cy: sy(f(x) + 0.13 * gauss()).toFixed(1) };
});

const targetPath = path(f, xMin, xMax);
const modelPath = path(model, xMin, xMax);
const bandX0 = sx(band[0]);
const bandX1 = sx(band[1]);
const plotTop = pad.t - 30;
const plotBottom = H - pad.b;
---

<figure class="overflow-hidden rounded-2xl border border-line bg-surface">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    class="block h-auto w-full"
    role="img"
    aria-label={t('figure.label')}
  >
    <defs>
      <clipPath id="xp-hero-clip">
        <rect x={pad.l} y={plotTop} width={W - pad.l - pad.r} height={plotBottom - plotTop}></rect>
      </clipPath>
      <filter id="xp-hero-glow" x="-10%" y="-10%" width="120%" height="120%">
        <feGaussianBlur stdDeviation="4"></feGaussianBlur>
      </filter>
    </defs>
    <g clip-path="url(#xp-hero-clip)">
      <rect
        x={bandX0}
        y={plotTop}
        width={bandX1 - bandX0}
        height={plotBottom - plotTop}
        class="fill-band"
      ></rect>
      <line
        x1={bandX0}
        x2={bandX0}
        y1={plotTop}
        y2={plotBottom}
        class="stroke-band-edge"
        stroke-dasharray="6 6"
        stroke-width="1.5"
      ></line>
      <line
        x1={bandX1}
        x2={bandX1}
        y1={plotTop}
        y2={plotBottom}
        class="stroke-band-edge"
        stroke-dasharray="6 6"
        stroke-width="1.5"
      ></line>
      <line
        x1={pad.l}
        x2={W - pad.r}
        y1={sy(0)}
        y2={sy(0)}
        class="stroke-line"
        stroke-width="1"
      ></line>
      <path
        d={targetPath}
        fill="none"
        class="stroke-target"
        stroke-width="2"
        stroke-dasharray="3 7"
        stroke-linecap="round"
        opacity="0.75"
      ></path>
      {points.map((p) => (
        <circle cx={p.cx} cy={p.cy} r="4.5" class="fill-target" opacity="0.9" />
      ))}
      <path
        d={modelPath}
        fill="none"
        class="stroke-model"
        stroke-width="9"
        opacity="0.28"
        filter="url(#xp-hero-glow)"
      ></path>
      <path
        d={modelPath}
        fill="none"
        class="stroke-model"
        stroke-width="3.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </g>
    <g class="fill-muted max-sm:hidden" font-size="17" font-weight="600">
      <text x={(bandX0 + bandX1) / 2} y={pad.t - 12} text-anchor="middle">
        {t('figure.train')}
      </text>
      <text x={(pad.l + bandX0) / 2} y={pad.t - 12} text-anchor="middle">
        {t('figure.extrapolation')}
      </text>
      <text x={(bandX1 + W - pad.r) / 2} y={pad.t - 12} text-anchor="middle">
        {t('figure.extrapolation')}
      </text>
    </g>
  </svg>
  <figcaption class="flex flex-wrap gap-x-5 gap-y-1 border-t border-line px-4 py-3 text-sm text-muted">
    <span class="inline-flex items-center gap-2">
      <span class="inline-block h-0.5 w-5 border-t-2 border-dotted border-target"></span>
      {t('figure.legend.target')}
    </span>
    <span class="inline-flex items-center gap-2">
      <span class="inline-block size-2.5 rounded-full bg-target"></span>
      {t('figure.legend.data')}
    </span>
    <span class="inline-flex items-center gap-2">
      <span class="inline-block h-1 w-5 rounded-full bg-model"></span>
      {t('figure.legend.model')}
    </span>
    <span class="inline-flex items-center gap-2">
      <span class="inline-block size-3 rounded-sm border border-dashed border-band-edge bg-band"></span>
      {t('figure.train')}
    </span>
  </figcaption>
</figure>
