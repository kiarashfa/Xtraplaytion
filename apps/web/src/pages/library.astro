---
import Library from '../components/library/Library.svelte';
import { useTranslations } from '../i18n';
import Base from '../layouts/Base.astro';

const t = useTranslations();
---

<Base title={t('lib.title')} description={t('lib.description')}>
  <section class="mx-auto w-full max-w-5xl px-4 py-8 sm:px-6">
    <h1 class="mb-3 text-2xl font-bold">{t('lib.title')}</h1>
    <Library client:only="svelte">
      <p slot="fallback" class="text-muted">
        {t('lib.loading')}
      </p>
    </Library>
  </section>
</Base>
