---
import { useTranslations } from '../i18n';
import { LESSONS } from '../lib/lessons.ts';
import { url } from '../lib/url.ts';
import Base from './Base.astro';

interface Props {
  frontmatter: { title: string; description: string; n: number; minutes: number };
}

const t = useTranslations();
const { frontmatter: fm } = Astro.props;
const at = LESSONS.findIndex((l) => l.n === fm.n);
const prev = at > 0 ? LESSONS[at - 1] : null;
const next = at >= 0 && at + 1 < LESSONS.length ? LESSONS[at + 1] : null;
---

<Base title={fm.title} description={fm.description}>
  <article class="lesson mx-auto max-w-[720px] py-8 sm:py-12">
    <p class="flex flex-wrap items-center gap-2.5 text-[13px] font-medium text-muted">
      <a
        href={url('lessons/')}
        class="inline-flex h-6 items-center rounded-full bg-accent-soft px-2.5 font-semibold text-accent"
      >
        {t('lessons.lesson', { n: fm.n })}
      </a>
      <span>{t('lessons.minutes', { n: fm.minutes })}</span>
      <span aria-hidden="true">·</span>
      <span>{t('lessons.interactive')}</span>
    </p>
    <h1>{fm.title}</h1>
    <slot />
    <nav class="not-prose mt-12 grid gap-3 sm:grid-cols-2" aria-label={t('lessons.more')}>
      {prev && (
        <a
          href={url(`lessons/${prev.slug}/`)}
          class="xp-card flex flex-col gap-1 p-4 hover:border-accent"
        >
          <span class="text-[13px] font-semibold text-muted">{t('lessons.prev')}</span>
          <span class="font-bold">{prev.title}</span>
        </a>
      )}
      {next && (
        <a
          href={url(`lessons/${next.slug}/`)}
          class="xp-card flex flex-col gap-1 p-4 text-end hover:border-accent sm:col-start-2"
        >
          <span class="text-[13px] font-semibold text-muted">{t('lessons.next')}</span>
          <span class="font-bold">{next.title}</span>
        </a>
      )}
    </nav>
  </article>
</Base>
