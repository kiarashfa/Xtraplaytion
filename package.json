{
  "name": "xtraplaytion",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @xtraplaytion/web dev",
    "build": "pnpm --filter @xtraplaytion/web build",
    "preview": "pnpm --filter @xtraplaytion/web preview",
    "lint": "eslint .",
    "format": "prettier --write . !pnpm-lock.yaml !THIRD_PARTY.md !**/fixtures/*.json",
    "format:check": "prettier --check . !pnpm-lock.yaml !THIRD_PARTY.md !**/fixtures/*.json",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @xtraplaytion/web test:e2e",
    "test:engines": "pnpm -r --if-present test:engines",
    "notices:check": "pnpm --filter @xtraplaytion/web notices:check",
    "notices:update": "pnpm --filter @xtraplaytion/web notices:update",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm notices:check"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100,
    "endOfLine": "lf",
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-svelte"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  }
}
